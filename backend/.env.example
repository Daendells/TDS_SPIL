# ====================================
# TDS Backend Environment Variables
# ====================================

# Application
ENV=development
WEB_PORT=8080
GIN_MODE=debug

# Database (for local non-docker development)
DB_HOST=localhost
DB_PORT=3306
DB_USER=tds_user
DB_PASSWORD=tds_pass
DB_NAME=tds

# JWT
JWT_SECRET=your-secret-key-here-change-in-production

# LLM / Groq API (if using)
GROQ_API_KEY=your-groq-api-key-here

# File Upload
MAX_UPLOAD_SIZE=10485760

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
