# ================================================
# Production Environment Variables
# ================================================
# 
# PENTING: 
# - JANGAN COMMIT FILE INI KE GIT!
# - Copy dari .env.prod.example
# - Gunakan values yang aman untuk production
#

# Database Credentials (GANTI DENGAN VALUES YANG AMAN!)
MYSQL_ROOT_PASSWORD=your-super-secret-root-password-here
DB_USER=tds_user_prod
DB_PASSWORD=your-super-secret-db-password-here
DB_NAME=tds

# JWT Secret (GUNAKAN RANDOM STRING YANG PANJANG!)
JWT_SECRET=your-super-long-random-jwt-secret-minimum-32-characters-here

# LLM API
GROQ_API_KEY=your-groq-api-key-here

# SSO Integration (isi sesuai konfigurasi SSO Portal)
# SSO_BASE_URL dipakai backend container untuk server-to-server call
# Jika SSO backend berjalan di host machine dari Docker, gunakan host.docker.internal
SSO_BASE_URL=http://host.docker.internal:5000
SSO_FRONTEND_URL=https://sso.yourdomain.com
SSO_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SSO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SSO_CALLBACK_URL=https://pe.spil.co.id/tds-api/api/auth/sso/callback
FRONTEND_URL=https://pe.spil.co.id/tds
BACKEND_PUBLIC_URL=https://pe.spil.co.id/tds-api

# Frontend API Endpoint
# Ganti dengan domain/IP production Anda
NEXT_PUBLIC_API_ENDPOINT=https://pe.spil.co.id/tds-api
NEXT_PUBLIC_BASE_PATH=/tds
